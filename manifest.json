{
  "manifest_version": 3,
  "name": "MentionFox Lens",
  "version": "0.2.0",
  "description": "Free claim X-ray and AI-readiness check for the page you are on. Runs on your device when possible.",
  "minimum_chrome_version": "139",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open MentionFox Lens",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "commands": {
    "open-lens": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the MentionFox Lens side panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
